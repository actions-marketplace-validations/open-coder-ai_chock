    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"/tmp/claude-0/-home-user/48152925-4fa4-5342-ac22-0d73478e5b55/scratchpad/ck312/bin/python3.12\" \"${CLAUDE_PROJECT_DIR}/.chock/bin/claude_code.py\" --gate \"${CLAUDE_PROJECT_DIR}/.chock/compiled/pin-github-actions/stop/gate.json\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
